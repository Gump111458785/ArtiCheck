# Set in the trusted server process; do not put secrets in web/dist or Git.
ARTICHECK_REVIEW_BASE_URL=https://your-model-provider.example/v1
ARTICHECK_REVIEW_MODEL=your-model-name
ARTICHECK_API_KEY=replace-with-your-provider-key
# Optional client token if your deployment supplies gateway authentication:
# ARTICHECK_REVIEW_TOKEN=your-gateway-token
