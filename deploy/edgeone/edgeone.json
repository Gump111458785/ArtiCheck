{
  "outputDirectory": ".",
  "installCommand": "",
  "buildCommand": "",
  "headers": [
    {
      "source": "/*.js",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/*.mjs",
      "headers": [{"key": "Content-Type", "value": "text/javascript; charset=utf-8"}]
    }
  ],
  "cloudFunctions": {
    "maxDuration": 120,
    "regions": {"overseas": ["ap-singapore"]}
  }
}
